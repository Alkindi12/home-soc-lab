# Run ./scripts/setup.sh to create .env from this file with generated passwords.
# .env is gitignored. Never commit real passwords.

# Pinned to the latest stable release when Stage 1 was built (2026-11-25)
WAZUH_VERSION=4.14.10

# Wazuh credentials. scripts/setup.sh replaces every change-me with a random
# 24-character password when it creates .env
INDEXER_USERNAME=admin
INDEXER_PASSWORD=change-me
API_USERNAME=wazuh-wui
API_PASSWORD=change-me
DASHBOARD_USERNAME=kibanaserver
DASHBOARD_PASSWORD=change-me
# Shared secret agents present when enrolling with the manager (Stage 2)
AGENT_ENROLLMENT_PASSWORD=change-me

# Isolated lab network (Stage 2): no internet access, no ports on the host
LAB_SUBNET=172.30.0.0/24
# Fixed address of the attacker container (Stage 4), inside LAB_SUBNET
ATTACKER_IP=172.30.0.100

# Victim credentials. DELIBERATELY WEAK: they are the targets of the
# brute-force attacks in Stage 4 and appear in common wordlists. They only
# exist inside the isolated lab network. Do not reuse them anywhere.
VICTIM_SSH_USER=labuser
VICTIM_SSH_PASSWORD=from-wordlist
VICTIM_DB_ROOT_PASSWORD=from-wordlist
VICTIM_DB_USER=shopapp
VICTIM_DB_PASSWORD=from-wordlist

# Normal activity baseline (normal-user client). STRONG passwords, generated
# by setup.sh: these are the legitimate users the attacks are compared with.
NORMAL_USER_IP=172.30.0.50
ADMIN_SSH_USER=alice
ADMIN_SSH_PASSWORD=change-me
SHOP_CUSTOMER_EMAIL=alice@shop.lab
SHOP_CUSTOMER_PASSWORD=change-me
